<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.xiuxian.miniapp-fishing.daily-reset</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/operator/.hermes/workspace/projects/xiuxian/.venv/bin/python3</string>
    <string>/Users/operator/.hermes/workspace/projects/xiuxian/fishing/reset_miniapp_fishing_day.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/operator/.hermes/workspace/projects/xiuxian/fishing</string>
  <!-- launchd reads Hour/Minute in the host's local time zone: this fires at
       Asia/Shanghai midnight only on a host set to Asia/Shanghai. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/operator/.hermes/workspace/projects/xiuxian/fishing/state/miniapp_fishing/daily-reset.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/operator/.hermes/workspace/projects/xiuxian/fishing/state/miniapp_fishing/daily-reset.launchd.error.log</string>
</dict>
</plist>
