+    def _notify_timing_update(self) -> None:
+        """Wake only schedules that have not submitted their action yet."""
+        signal = getattr(self, "_timing_updated", None)
+        if signal is not None:
+            signal.set()
+        self._timing_updated = asyncio.Event()
+
+    async def _wait_for_timing_target(self, plan: Any) -> bool:
+        """Recompute a pending deadline when an arrived receipt changes timing.
+
+        This uses receipt events, not faster API polling or a busy timer. A
+        charge already sent keeps its real start time; only its future release
+        can be replanned, with the same ticket and hold limits.
+        """
+        while True:
+            signal = getattr(self, "_timing_updated", None)
+            if signal is None:
+                signal = self._timing_updated = asyncio.Event()
+            target = plan()
+            sleeper = asyncio.create_task(self._sleep_until(target))
+            changed = asyncio.create_task(signal.wait())
+            completed, okay = False, False
+            try:
+                done, _ = await asyncio.wait((sleeper, changed), return_when=asyncio.FIRST_COMPLETED)
+                if sleeper in done:
+                    completed, okay = True, sleeper.result()
+            finally:
+                for task in (sleeper, changed):
+                    if not task.done():
+                        task.cancel()
+                await asyncio.gather(sleeper, changed, return_exceptions=True)
+            if completed and not okay:
+                return False
+            if completed and not signal.is_set():
+                return True
