# Telegram personal account API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Session file will be created locally after first login
TG_SESSION_NAME=state/demo-primary

# Target forum/supergroup. Prefer the public username when available.
TG_TARGET=@example_game_group
TG_TOPIC_ID=7310786
TG_MESSAGE=.闭关修炼
TG_REPLY_BOT_USERNAME=fanrenxiuxian_bot
TG_POST_SEND_WAIT_SECONDS=8
TG_POST_SEND_MAX_WAIT_SECONDS=45
TG_POST_SEND_POLL_SECONDS=3
# Multiple trigger snippets supported with | separator
TG_RESET_TRIGGER_TEXT=冷却时间被重置|可以立刻再次闭关|毫无疲惫之感
# If the bot replies that time has not arrived yet, parse remaining cooldown and retry.
TG_COOLDOWN_MARKER_TEXT=时间没到|時間沒到|还不能|還不能|后可再|後可再|后再来|後再來|后再试|後再試
TG_COOLDOWN_RETRY_BUFFER_SECONDS=3
TG_COOLDOWN_RETRY_MAX_WAIT_SECONDS=900
TG_COOLDOWN_STATE_PATH=state/cooldown_retry.json
TG_LAST_ATTEMPT_PATH=state/last_attempt.json
TG_RUN_MAX_SECONDS=180
TG_WATCHDOG_LOCK_STALE_SECONDS=1800

# Cross-account send spacing. All flows must point at the SAME file for the
# 1 msg/sec limit to be global (scripts/lib/account_flow_paths.sh does this).
TG_GLOBAL_SEND_GATE_STATE_PATH=state/global_telegram_send_gate.json
TG_GLOBAL_MIN_SEND_SPACING_SECONDS=1

# Optional safety switch. Set to 1 to disable actual sending.
TG_DRY_RUN=0
