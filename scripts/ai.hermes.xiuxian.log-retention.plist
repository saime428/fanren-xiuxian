<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.xiuxian.log-retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/operator/.hermes/workspace/projects/xiuxian/.venv/bin/python</string>
    <string>/Users/operator/.hermes/workspace/projects/xiuxian/scripts/xiuxian_log_retention_apply.py</string>
    <string>--state-root</string>
    <string>/Users/operator/.hermes/workspace/projects/xiuxian/state/accounts</string>
    <string>--keep-mib</string>
    <string>10</string>
    <string>--output</string>
    <string>/Users/operator/.hermes/workspace/projects/xiuxian/state/xiuxian-log-retention-apply.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/operator/.hermes/workspace/projects/xiuxian</string>
  <!-- Weekly at a fixed local time (Sunday 06:30, after the 03:00-05:45 fate-cards
       batch): a StartInterval timer restarts from zero on every reload/reboot. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/operator/.hermes/workspace/projects/xiuxian/state/log-retention.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/operator/.hermes/workspace/projects/xiuxian/state/log-retention.launchd.log</string>
</dict>
</plist>
