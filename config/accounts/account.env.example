# Template for per-account config: copy to tg<account_id>.env and fill in.
# Every file in this directory except this template is gitignored; never commit credentials.
#
# Do not set TG_TARGET / TG_TOPIC_ID / TG_REPLY_SCAN_*: scripts/lib/account_flow_paths.sh
# forces the canonical outbound topic for every flow. Do not set
# TG_SESSION_FALLBACK_NAME either: the same helper picks each account's session seed
# (a credential alias such as tg9100000006 -> tg9100000007 is set in its wrappers).
export XIU_ACCOUNT_SLUG='tg<account_id>'

# From https://my.telegram.org — per-account API app credentials.
export TG_API_ID=''
export TG_API_HASH=''
